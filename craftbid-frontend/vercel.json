{
  "version": 2,
  "outputDirectory": "dist/craftbid-frontend/browser",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://craftbiid.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://craftbiid.onrender.com/uploads/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
